{
  "name": "claude-discord-bot",
  "version": "0.1.0",
  "description": "Discord bot for remote Claude Code session control with approval workflow",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "claude",
    "discord",
    "bot",
    "pty",
    "remote"
  ],
  "author": "seigo2016",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^8.56.0",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "undici@6.21.3": "6.28.1",
      "ajv@<6.14.0": "6.14.0",
      "brace-expansion@<1.1.21": "1.1.21",
      "flatted@<3.4.2": "3.4.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "lodash@<4.18.0": "4.18.1",
      "minimatch@<3.1.4": "3.1.5",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "ws@>=8.0.0 <8.21.0": "8.21.0"
    }
  },
  "packageManager": "pnpm@10.34.6"
}
